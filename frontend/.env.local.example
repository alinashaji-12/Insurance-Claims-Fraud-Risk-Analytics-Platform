# Public URL of claimguard-api ONLY (not claimguard-web). No trailing slash.
# Baked in at `next build` — after changing on Render, Clear build cache & deploy web.
NEXT_PUBLIC_API_URL=https://claimguard-api-ruwo.onrender.com

# For a fully local API instead, point this at your API base URL, e.g.:
# NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com
