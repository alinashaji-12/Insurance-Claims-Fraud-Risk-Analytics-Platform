# Database URL — SQLite for local / hackathon demo
DATABASE_URL=sqlite:///./claimguard.db
# Production (Render Postgres): use the dashboard connection string, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Requires: pip install psycopg2-binary  (not needed for SQLite)

# CORS origins (comma-separated, no trailing slashes)
# Production (Render frontend):
ALLOWED_ORIGINS=https://claimguard-web.onrender.com
# Add extra origins as needed, e.g.:
# ALLOWED_ORIGINS=https://claimguard-web.onrender.com,https://YOUR-WEB.onrender.com
